{
 "uid": "c2-avail",
 "title": "C2 Availability and Failover",
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Writes succeeding (last 1 min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100 * increase(c2_probe_ok_total[1m]) / clamp_min(increase(c2_probe_ok_total[1m]) + increase(c2_probe_fail_total[1m]), 1)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 99
       },
       {
        "color": "green",
        "value": 99.9
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Serving site",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "c2_probe_serving_site == 1",
     "legendFormat": "{{site}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": ""
    },
    "overrides": []
   },
   "options": {
    "textMode": "name",
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Failovers",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "c2_failovers_total",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": ""
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Last failover took",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "c2_last_failover_seconds",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Client writes per second: succeeded and failed",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "rate(c2_probe_ok_total[10s])",
     "legendFormat": "succeeded"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "rate(c2_probe_fail_total[10s])",
     "legendFormat": "failed"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 20
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "failed"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "succeeded"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Which site serves the writes",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "c2_probe_serving_site",
     "legendFormat": "site {{site}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "stepAfter",
      "fillOpacity": 30
     },
     "max": 1,
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Site health as seen by the witness (1 = writable)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "c2_site_writable",
     "legendFormat": "site {{site}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "c2_active_site",
     "legendFormat": "active: {{site}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineInterpolation": "stepAfter"
     },
     "max": 1.1,
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Write latency (ms)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "c2_probe_latency_ms",
     "legendFormat": "latency"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   }
  }
 ]
}